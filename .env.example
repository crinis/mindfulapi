# Environment Configuration Example

# Environment
NODE_ENV=production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Port
PORT=3000

# SSL Verification
# Set to 'true' to ignore SSL certificate errors (useful for development/self-signed certs)
# IGNORE_HTTPS_ERRORS=true

# Scan Basic Auth Credentials Encryption
# =====================================
# Required only when using scanOptions.basicAuth in scan requests.
# Must be a 32-byte key encoded as base64 or hex.
# Example (base64): openssl rand -base64 32
# ENCRYPTION_KEY=

# Browser Configuration
# =====================
# External Playwright browser connection (optional).
# If set, connects to external Playwright instance via WebSocket.
# If not set, launches a local headless Chromium instance.
#
# PLAYWRIGHT_WS_URL=ws://playwright:3000

# Database Configuration
# For Docker deployments, use /data/database.sqlite with volume mounting.
DATABASE_PATH=./data/database.sqlite

# Cleanup Service Configuration
# =============================

# Enable or disable automatic cleanup (default: true)
CLEANUP_ENABLED=true

# Cleanup schedule using cron expression (default: daily at 2:00 AM)
CLEANUP_INTERVAL=0 2 * * *

# Number of days to retain scans before cleanup (default: 30)
CLEANUP_RETENTION_DAYS=30

# Crawl Concurrency
# =================
# Maximum number of pages analyzed concurrently within a single scan job
# (crawl and url_list modes). Default: 4, max: 16.
# CRAWL_CONCURRENCY=4

# Scan Concurrency
# ================
# Maximum number of scan jobs processed in parallel by the queue worker.
# In-flight pages = SCAN_CONCURRENCY x CRAWL_CONCURRENCY, all sharing one
# browser. Default: 1, max: 8.
# SCAN_CONCURRENCY=1

# SSRF Protection
# ===============
# By default the scanner refuses targets that resolve to private or reserved
# network ranges (loopback, RFC 1918, link-local/metadata, etc.) to prevent
# server-side request forgery.
#
# Set to 'true' to allow scanning internal/intranet/staging targets. Only do
# this when the API is not reachable by untrusted clients.
# SCAN_ALLOW_PRIVATE_TARGETS=false
#
# Alternatively, allow specific hosts through while keeping the block on for
# everything else (comma-separated hostnames).
# SCAN_TARGET_ALLOW_HOSTS=staging.internal,ci.example.test

# Scan Target Policy (SSRF protection)
# ====================================
# By default, scan targets that are (or resolve to) private/reserved network
# addresses (localhost, 10.x, 192.168.x, 169.254.x, ...) are rejected so API
# clients cannot make the server-side browser fetch internal services.
#
# Allow scanning private/internal targets entirely (e.g. intranet audits):
# SCAN_ALLOW_PRIVATE_TARGETS=false
#
# Or allow specific internal hostnames while keeping the block enabled
# (comma-separated):

# Authentication Token for API access
# SECURITY: Change this to a strong, unique token in production.
# The application refuses to start when AUTH_TOKEN is unset, unless you
# explicitly opt out of authentication with AUTH_DISABLED=true.
AUTH_TOKEN=your-secure-api-token-here

# Explicitly run the API without authentication (NOT recommended).
# Only takes effect when AUTH_TOKEN is unset.
# AUTH_DISABLED=false

# CORS
# ====
# Comma-separated list of allowed origins for browser clients. Leave unset to
# keep CORS disabled (no cross-origin browser access).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Rate Limiting
# =============
# Fixed-window throttle applied per client. TTL is the window length in seconds
# and LIMIT is the max requests allowed within it.
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100

# AI Accessibility Audit (optional, LLM agents)
# =============================================
# Opt-in agentic layer that judges what axe-core cannot (e.g. image alt-text
# quality). Disabled by default; when enabled, clients still opt in per scan
# via `aiAudit.skills`. Element screenshots + attributes are sent to the
# configured provider — review the privacy note in the README before enabling.
#
# AGENT_ENABLED=true
#
# Default provider/model used by every skill unless overridden below.
# Provider adapter: openai | anthropic | openai-compatible
# Use `openai-compatible` + AGENT_BASE_URL for OpenRouter, DeepSeek, or a local
# model server (Ollama/vLLM/LM Studio) — broadest model coverage.
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4.1-mini
# AGENT_API_KEY=
# AGENT_BASE_URL=https://openrouter.ai/api/v1
#
# Skills the server permits clients to request (comma-separated). Defaults to
# all built-in skills when unset.
#   image_alt_text   — judges the quality of an existing alt text (needs vision).
#   heading_structure — judges heading semantics axe can't: descriptive text
#                       (WCAG 2.4.6), unheaded sections (2.4.10, AAA), and
#                       styled-text-as-heading (1.3.1). Text-only, one request
#                       per page. Structural checks (skipped levels, empty
#                       headings, missing h1) stay with axe-core.
#   link_purpose      — judges whether link text conveys its purpose: generic
#                       filler / non-descriptive / raw-URL names (WCAG 2.4.4, A)
#                       and names that only work in context (2.4.9, AAA).
#                       Text-only, one request per page. Missing names and
#                       identical-name/different-target links stay with axe-core.
#   form_labels       — judges form-label clarity axe can't: uninformative or
#                       ambiguous labels (WCAG 2.4.6) and fields needing
#                       format/constraint instructions the user is never given
#                       (3.3.2). Text-only, one request per page. Missing /
#                       title-only / multiple labels stay with axe-core, and
#                       deterministic facts (required state, placeholder-as-label,
#                       grouping, autocomplete tokens) are out of scope.
# AGENT_SKILLS=image_alt_text,heading_structure,link_purpose,form_labels
#
# Per-skill model overrides (optional): AGENT_SKILL_<SKILL_ID>_{PROVIDER,MODEL,
# API_KEY,BASE_URL}. Each field falls back to the AGENT_* default when unset, so
# you only set what differs. Skills have different needs — image_alt_text wants a
# vision model; heading_structure is text-only and runs fine on a cheaper one:
# AGENT_SKILL_IMAGE_ALT_TEXT_PROVIDER=openai-compatible
# AGENT_SKILL_IMAGE_ALT_TEXT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_SKILL_IMAGE_ALT_TEXT_MODEL=openai/gpt-4o-mini
# AGENT_SKILL_IMAGE_ALT_TEXT_API_KEY=sk-or-...
# AGENT_SKILL_HEADING_STRUCTURE_MODEL=gpt-4.1-nano
# AGENT_SKILL_LINK_PURPOSE_MODEL=gpt-4.1-nano
# form_labels weighs instruction/label needs, so give it a bit more capability:
# AGENT_SKILL_FORM_LABELS_MODEL=gpt-4.1-mini
#
# Tuning / cost controls (all optional; sensible defaults shown). The unit and
# token caps share a `_PER_PAGE`/`_PER_SCAN`/`_PER_REQUEST` scope suffix.
# AGENT_CONCURRENCY=4                  # concurrent per-unit requests
# AGENT_MAX_UNITS_PER_PAGE=30          # cap collected units per page
# AGENT_MAX_UNITS_PER_SCAN=200         # cap evaluated units per scan
# AGENT_MAX_TOKENS_PER_REQUEST=1000    # output-token cap per request
# AGENT_TOKEN_BUDGET_PER_SCAN=2000000  # total token budget per scan (0 = unlimited)
# AGENT_REQUEST_TIMEOUT_MS=60000
# AGENT_MAX_IMAGE_BYTES=1500000        # skip element screenshots larger than this
# AGENT_TEMPERATURE=0
