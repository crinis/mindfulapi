# Environment Configuration Example
#
# This file follows the main branch (the :dev image). docker-compose.yml runs
# the :latest image, release 0.7.1; comments marked (unreleased) describe
# behaviour 0.7.1 does not have yet. 0.7.1 also clamps some out-of-range
# numbers instead of refusing them.
#
# An empty value (VAR=) means the same as leaving the variable unset: the
# default applies. (unreleased: 0.7.1 stops on an empty boolean, enum or most
# numeric variables, e.g. AGENT_PROVIDER=)

# Environment
# docker-compose.yml always runs the container with NODE_ENV=production. For
# local development (npm run start:dev) use development, which also enables SQL
# query logging.
NODE_ENV=production

# Container image used by docker-compose.yml. Keep latest for stable updates,
# pin a release (for example :0.7.0), or opt into unreleased builds with :dev.
# MINDFULAPI_IMAGE=ghcr.io/crinis/mindfulapi:latest

# Local-development wiring. docker-compose.yml passes every other variable in
# this file to the container, but pins NODE_ENV, REDIS_HOST, REDIS_PORT,
# REDIS_PASSWORD, PORT, PLAYWRIGHT_WS_URL and DATABASE_PATH to the bundled
# services, so the values below only affect local runs (PORT also sets the
# published host port).

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Port
PORT=3000

# Host address docker-compose.yml publishes the API port on (Compose only).
# The default 127.0.0.1 makes the API reachable only from this host, e.g. by a
# reverse proxy. Docker's published ports bypass host firewalls such as ufw, so
# 0.0.0.0 exposes the API on every interface over plain HTTP; choose it only
# for setups without a reverse proxy on the same host.
# BIND_ADDRESS=127.0.0.1

# SSL Verification
# Set to 'true' to ignore SSL certificate errors (useful for development/self-signed certs)
# IGNORE_HTTPS_ERRORS=true

# Scan Basic Auth Credentials Encryption
# =====================================
# Required only when using scanOptions.basicAuth in scan requests.
# Must be a 32-byte key encoded as base64 or hex. Run
# `openssl rand -base64 32` in a terminal and paste the output here (.env does
# not execute commands).
# ENCRYPTION_KEY=

# Browser Configuration
# =====================
# Secret path of the Playwright browser server (REQUIRED for docker-compose.yml).
# Compose starts the run-server with `--path /<this value>` and points the API
# at ws://playwright:3000/<this value>. Pages scanned in the browser container
# can reach the run-server, which accepts browser connections only on this
# path, so make it long and random: run `openssl rand -hex 16` in a terminal and
# paste the output (letters and digits only). Compose refuses to start while it
# is empty.
PLAYWRIGHT_WS_PATH=
#
# External Playwright browser connection for local runs (optional; compose sets
# it from PLAYWRIGHT_WS_PATH). If set, connects to that Playwright server via
# WebSocket, e.g. one started with
# `npx playwright run-server --port 3001 --path /<secret path>`; if not set,
# launches a local headless Chromium instance.
# PLAYWRIGHT_WS_URL=ws://localhost:3001/<secret path>

# Database Configuration
# For Docker deployments, use /data/database.sqlite with volume mounting.
DATABASE_PATH=./data/database.sqlite

# Cleanup Service Configuration
# =============================

# Enable or disable automatic cleanup (default: true). The manual
# POST /v1/cleanup endpoint runs regardless of this flag.
CLEANUP_ENABLED=true

# Cleanup schedule using cron expression (default: daily at 2:00 AM). Five
# fields, or six with seconds first; an invalid expression stops the server.
# With `npm run start:dev` this is read before .env is loaded; set it in the
# shell instead (npm start and Docker are unaffected).
CLEANUP_INTERVAL=0 2 * * *

# Number of days to retain finished scans before cleanup (default: 30, allowed
# 0-36500). 0 deletes every finished (completed, failed or canceled) scan on
# each run; pending, running and analyzing scans are never deleted
# (unreleased: 0.7.1 deletes scans of every status).
CLEANUP_RETENTION_DAYS=30

# Crawl Concurrency
# =================
# Maximum number of pages analyzed concurrently within a single scan job
# (crawl and url_list modes). Default: 4, allowed 1-16 (other values stop the
# server at startup).
# CRAWL_CONCURRENCY=4

# Scan Concurrency
# ================
# Maximum number of scan jobs processed in parallel by the queue worker.
# In-flight pages = SCAN_CONCURRENCY x CRAWL_CONCURRENCY, all sharing one
# browser. Default: 1, allowed 1-8. With `npm run start:dev` this is read
# before .env is loaded; set it in the shell instead.
# SCAN_CONCURRENCY=1

# Page Timeout
# ============
# Time in milliseconds one page may take in every scan mode: navigation, axe
# analysis, AI evidence collection (which ends 15 seconds earlier) and, in
# crawls, link extraction. A page that takes longer is closed and counts as
# failed. Default: 120000 (two minutes), allowed 30000-1800000. (unreleased:
# 0.7.1 has no time limit per page)
# SCAN_PAGE_TIMEOUT_MS=120000

# SSRF Protection
# ===============
# By default the scanner refuses targets that resolve to private or reserved
# network ranges (loopback, RFC 1918, link-local/metadata, etc.) to prevent
# server-side request forgery.
#
# Set to 'true' to allow scanning internal/intranet/staging targets. Only do
# this when the API is not reachable by untrusted clients.
# SCAN_ALLOW_PRIVATE_TARGETS=false
#
# Alternatively, allow specific hosts through while keeping the block on for
# everything else (comma-separated hostnames, exact case-insensitive match;
# wildcards such as *.ddev.site are not supported).
# SCAN_TARGET_ALLOW_HOSTS=staging.internal,ci.example.test

# Authentication Token for API access (REQUIRED - set it before starting)
# Run `openssl rand -hex 32` in a terminal and paste the output after the `=`.
# Clients send it as `Authorization: Bearer <token>`.
# The application refuses to start while AUTH_TOKEN is empty or unset, unless
# you explicitly opt out of authentication with AUTH_DISABLED=true. It also
# refuses the placeholder `your-secure-api-token-here` that older versions of
# this file shipped (unreleased: 0.7.1 accepts it, so never keep it).
# docker-compose.yml requires this variable to be defined; to run without
# authentication there, keep it empty and set AUTH_DISABLED=true.
AUTH_TOKEN=

# Explicitly run the API without authentication (NOT recommended).
# Only takes effect when AUTH_TOKEN is unset.
# AUTH_DISABLED=false

# CORS
# ====
# Comma-separated list of allowed origins for browser clients. Leave unset to
# keep CORS disabled (no cross-origin browser access).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Rate Limiting
# =============
# Fixed-window throttle per client address and endpoint, for the API routes,
# applied before authentication (a wrong token counts too; unreleased: 0.7.1
# rejects a wrong token before counting it). TTL is the window
# length in seconds and LIMIT is the max requests allowed within it.
# THROTTLE_TTL=60          # 1-86400
# THROTTLE_LIMIT=100       # 1-1000000
#
# Behind a reverse proxy every request comes from the proxy, so all clients
# share one limit unless TRUST_PROXY names the proxy. One proxy in front: 1
# (the client address is then the last X-Forwarded-For entry). Also accepted:
# false, or a comma-separated list of IP addresses, CIDR subnets, loopback,
# linklocal, uniquelocal. `true` is refused: it would make the first
# X-Forwarded-For entry, which the client chooses, the address. With Docker
# Compose a proxy on the host connects from the Docker network gateway, not
# from loopback. Set it only when every request passes the proxy, or clients
# can pick their own address. (unreleased: 0.7.1 ignores TRUST_PROXY)
# TRUST_PROXY=1

# AI Accessibility Audit (optional, LLM agents)
# =============================================
# Opt-in agentic layer that judges what axe-core cannot (e.g. image alt-text
# quality). Disabled by default; when enabled, clients still opt in per scan
# with an `aiAudit` object (an empty `aiAudit: {}` runs every skill allowed by
# AGENT_SKILLS). Element screenshots + attributes and page text (headings,
# links, form labels, title, meta description) are sent to the configured
# provider — review the privacy note in the README before enabling.
#
# AGENT_ENABLED=true
#
# Provider adapter: openai | anthropic | openai-compatible
# Use `openai-compatible` + AGENT_BASE_URL for OpenRouter, DeepSeek, or a local
# model server (Ollama/vLLM/LM Studio) — broadest model coverage.
# AGENT_PROVIDER=openai
#
# AGENT_MODEL is the model for every skill. For OpenAI, leave it UNSET to use the
# built-in per-skill profile — each skill runs on the GPT-5 model + reasoning
# effort that A/B-tested best for it: heading_structure -> gpt-5.4-mini (low
# effort), image_alt_text -> gpt-5.4-mini (none), link_purpose/form_labels/
# page_title -> gpt-5.4-nano (none). Set it to force one model everywhere (add
# AGENT_REASONING_EFFORT if it is a reasoning model); it is REQUIRED for providers
# without a profile (anthropic, openai-compatible).
# AGENT_MODEL=gpt-5.4-mini
# AGENT_REASONING_EFFORT=none
# AGENT_API_KEY=
# AGENT_BASE_URL=https://openrouter.ai/api/v1
#
# Skills the server permits clients to request (comma-separated). Defaults to
# all built-in skills when unset or empty; unknown values are ignored.
#   image_alt_text   — judges the quality of an existing alt text (needs vision).
#   heading_structure — judges heading semantics axe can't: descriptive text
#                       (WCAG 2.4.6), unheaded sections (2.4.10, AAA), and
#                       styled-text-as-heading (1.3.1). Text-only, one request
#                       per page. Structural checks (skipped levels, empty
#                       headings, missing h1) stay with axe-core.
#   link_purpose      — judges whether link text conveys its purpose: generic
#                       filler / non-descriptive / raw-URL names (WCAG 2.4.4, A)
#                       and names that only work in context (2.4.9, AAA).
#                       Text-only, one request per page. Missing names and
#                       identical-name/different-target links stay with axe-core.
#   form_labels       — judges form-label clarity axe can't: uninformative or
#                       ambiguous labels (WCAG 2.4.6) and fields needing
#                       format/constraint instructions the user is never given
#                       (3.3.2). Text-only, one request per page. Missing /
#                       title-only / multiple labels stay with axe-core, and
#                       deterministic facts (required state, placeholder-as-label,
#                       grouping, autocomplete tokens) are out of scope.
#   page_title        — judges whether the page <title> describes the page
#                       (WCAG 2.4.2): placeholder/boilerplate titles ("Untitled
#                       Document", "Home") or titles that don't convey the topic.
#                       Text-only, one request per page. A missing/empty title
#                       stays with axe-core (document-title). SEO-safe: never
#                       penalizes the brand name, length, or keywords.
# AGENT_SKILLS=image_alt_text,heading_structure,link_purpose,form_labels,page_title
#
# Scan modes for which clients may request an AI audit (comma-separated).
# Defaults to single-page scans only. Add url_list and/or crawl explicitly to
# permit agent use for multi-page scans. (unreleased: 0.7.1 allows every scan
# mode)
# AGENT_ALLOWED_SCAN_MODES=single_url
#
# Per-skill overrides (optional): AGENT_SKILL_<SKILL_ID>_{PROVIDER,MODEL,API_KEY,
# BASE_URL,REASONING_EFFORT}. The OpenAI profile above already picks the tuned
# model + effort per skill, so use these only to CHANGE one — e.g. spend more
# reasoning on headings, route a skill to a different gateway, or run
# image_alt_text on a self-hosted vision model. Precedence, highest first:
#   model:  AGENT_SKILL_<ID>_MODEL > AGENT_MODEL > provider profile
#   effort: AGENT_SKILL_<ID>_REASONING_EFFORT > profile effort (only when the
#           profile supplied the model) > AGENT_REASONING_EFFORT
# So AGENT_REASONING_EFFORT does not change profiled skills. The effort is only
# sent to the `openai` provider; any effort value also omits temperature.
# Key and base URL: a skill inherits AGENT_API_KEY and AGENT_BASE_URL only while
# it stays on the global endpoint. If its override sets another PROVIDER, it
# inherits neither; if it sets a BASE_URL other than AGENT_BASE_URL (a trailing
# slash, the letter case of scheme and host, or a default port aside), it does
# not inherit the key.
# Give such a skill its own _API_KEY when its endpoint needs one. (unreleased:
# 0.7.1 inherits both in every override)
# AGENT_SKILL_HEADING_STRUCTURE_REASONING_EFFORT=medium
# AGENT_SKILL_IMAGE_ALT_TEXT_PROVIDER=openai-compatible
# AGENT_SKILL_IMAGE_ALT_TEXT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_SKILL_IMAGE_ALT_TEXT_MODEL=meta-llama/llama-3.2-90b-vision-instruct
# AGENT_SKILL_IMAGE_ALT_TEXT_API_KEY=sk-or-...
#
# Tuning / cost controls (all optional; sensible defaults shown, allowed ranges
# in brackets). The unit and token caps share a `_PER_PAGE`/`_PER_SCAN`/
# `_PER_REQUEST` scope suffix.
# AGENT_CONCURRENCY=4                  # concurrent per-unit requests [1-16]
# AGENT_MAX_UNITS_PER_PAGE=30          # cap collected units per page [1-500]
# AGENT_MAX_UNITS_PER_SCAN=200         # cap evaluated units per scan [1-10000] (input tokens and SDK retries not capped)
# AGENT_MAX_TOKENS_PER_REQUEST=2000    # output-token cap per request (incl. reasoning) [1-100000]
# AGENT_REQUEST_TIMEOUT_MS=60000       # [1000-600000]
# AGENT_MAX_IMAGE_BYTES=1500000        # skip element screenshots larger than this [1000-20000000]
# AGENT_TEMPERATURE=0                  # omitted for reasoning models [0-2]
# AGENT_REASONING_EFFORT=              # effort for a reasoning AGENT_MODEL (none|minimal|low|medium|high|xhigh; gpt-5.4+ reject 'minimal', use 'none')
