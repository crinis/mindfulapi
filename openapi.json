  "info": {
    "title": "MindfulAPI",
    "description": "Automated web accessibility scanning API powered by axe-core and Playwright. Built for use with the [mindfula11y](https://github.com/crinis/mindfula11y) TYPO3 extension. Errors are returned as RFC 9457 `application/problem+json`.",
    "version": "0.5.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Scans",
      "description": "Create and inspect accessibility scan runs"
    },
    {
      "name": "Reports",
      "description": "Generate HTML and PDF accessibility reports"
    },
    {
      "name": "Rules",
      "description": "List available axe-core rules and metadata"
    },
    {
      "name": "Cleanup",
      "description": "Manage retention cleanup lifecycle"
    },
    {
      "name": "Health",
      "description": "Liveness and readiness probes"
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "Current environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Set the AUTH_TOKEN environment variable to enable authentication. When authentication is disabled (AUTH_DISABLED=true), the token is ignored.",
        "type": "http"
      }
    },
    "schemas": {
      "BasicAuthCredentialsDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "scanner-user",
            "minLength": 1,
            "maxLength": 256,
            "description": "Username for HTTP Basic Authentication."
          },
          "password": {
            "type": "string",
            "example": "scanner-password",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Password for HTTP Basic Authentication. Stored encrypted at rest."
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "ScanOptionsDto": {
        "type": "object",
        "properties": {
          "rootElement": {
            "type": "string",
            "example": "main",
            "description": "CSS selector to restrict the scan to a specific page region. Scans the entire page when omitted.",
            "minLength": 1
          },
          "ruleIds": {
            "example": [
              "color-contrast",
              "image-alt"
            ],
            "description": "Specific axe rule IDs to run. All rules run when omitted. See GET /rules for available IDs.",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basicAuth": {
            "description": "Optional HTTP Basic Authentication credentials used during page loading. Credentials are encrypted at rest and never returned in API responses.",
            "allOf": [
              {
                "$ref": "#/components/schemas/BasicAuthCredentialsDto"
              }
            ]
          }
        }
      },
      "CreateSingleUrlScanDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "single_url"
            ],
            "example": "single_url"
          },
          "url": {
            "type": "string",
            "example": "https://example.com",
            "format": "uri",
            "description": "Single page URL to analyze."
          },
          "scanOptions": {
            "$ref": "#/components/schemas/ScanOptionsDto"
          }
        },
        "required": [
          "mode",
          "url"
        ]
      },
      "CreateUrlListScanDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "url_list"
            ],
            "example": "url_list"
          },
          "urls": {
            "type": "array",
            "example": [
              "https://example.com",
              "https://example.com/about"
            ],
            "items": {
              "type": "string",
              "format": "uri"
            },
            "uniqueItems": true,
            "minItems": 2,
            "maxItems": 500,
            "description": "Explicit list of page URLs to analyze."
          },
          "scanOptions": {
            "$ref": "#/components/schemas/ScanOptionsDto"
          }
        },
        "required": [
          "mode",
          "urls"
        ]
      },
      "CrawlOptionsDto": {
        "type": "object",
        "properties": {
          "maxPages": {
            "type": "integer",
            "example": 250,
            "description": "Maximum number of pages to crawl and analyze.",
            "default": 250,
            "minimum": 1,
            "maximum": 5000
          },
          "maxDepth": {
            "type": "integer",
            "example": 4,
            "description": "Maximum crawl depth from each start URL.",
            "default": 4,
            "minimum": 0,
            "maximum": 20
          },
          "strategy": {
            "type": "string",
            "enum": [
              "all",
              "same_hostname",
              "same_domain",
              "same_origin"
            ],
            "example": "same_hostname",
            "default": "same_hostname",
            "description": "URL discovery strategy. `same_hostname` restricts to the seed host, `same_domain` allows subdomains, `same_origin` also matches protocol, `all` follows any link."
          },
          "globs": {
            "example": [
              "https://example.com/docs/**"
            ],
            "description": "Glob patterns. A discovered URL must match at least one pattern to be crawled.",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
