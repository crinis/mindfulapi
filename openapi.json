{
  "openapi": "3.0.0",
  "paths": {
    "/v1/scans": {
      "post": {
        "description": "Queues a new axe-core scan run in one of three modes: single URL, URL list, or crawl. Processing runs asynchronously in the background. Poll GET /scans/:id for status and results.",
        "operationId": "createScan",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CreateSingleUrlScanDto"
                  },
                  {
                    "$ref": "#/components/schemas/CreateUrlListScanDto"
                  },
                  {
                    "$ref": "#/components/schemas/CreateCrawlScanDto"
                  }
                ],
                "discriminator": {
                  "propertyName": "mode",
                  "mapping": {
                    "single_url": "#/components/schemas/CreateSingleUrlScanDto",
                    "url_list": "#/components/schemas/CreateUrlListScanDto",
                    "crawl": "#/components/schemas/CreateCrawlScanDto"
                  }
                }
              },
              "examples": {
                "singleUrl": {
                  "summary": "Single URL run",
                  "description": "Analyze one page URL.",
                  "value": {
                    "mode": "single_url",
                    "url": "https://example.com",
                    "scanOptions": {
                      "rootElement": "main",
                      "basicAuth": {
                        "username": "scanner-user",
                        "password": "scanner-password"
                      }
                    }
                  }
                },
                "urlList": {
                  "summary": "URL list run",
                  "description": "Analyze a fixed list of URLs.",
                  "value": {
                    "mode": "url_list",
                    "urls": [
                      "https://example.com",
                      "https://example.com/about"
                    ],
                    "scanOptions": {
                      "ruleIds": [
                        "image-alt",
                        "color-contrast"
                      ]
                    }
                  }
                },
                "crawl": {
                  "summary": "Crawl run",
                  "description": "Discover and analyze pages by crawling from one or more seeds.",
                  "value": {
                    "mode": "crawl",
                    "startUrls": [
                      "https://example.com"
                    ],
                    "scanOptions": {
                      "rootElement": "main"
                    },
                    "crawlOptions": {
                      "maxPages": 250,
                      "maxDepth": 4,
                      "strategy": "same_hostname",
                      "globs": [
                        "https://example.com/docs/**"
                      ],
                      "excludeGlobs": [
                        "**/private/**"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scan run created and queued",
            "headers": {
              "Location": {
                "description": "URL of the created scan run resource",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Start a new accessibility scan run",
        "tags": [
          "Scans"
        ]
      },
      "get": {
        "description": "Returns a page of scan run summaries ordered by creation date, newest first. Summaries omit per-issue detail and expose per-severity issue counts instead. Use `limit`/`offset` to paginate and the optional `target` query parameter to filter runs by one of their input targets.",
        "operationId": "listScans",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of items to return (1-100).",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "Number of items to skip.",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "integer"
            }
          },
          {
            "name": "target",
            "required": false,
            "in": "query",
            "description": "Filter runs by exact match in normalized input targets. When omitted, all scan runs are returned.",
            "schema": {
              "format": "uri",
              "example": "https://example.com",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of results",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponseDto"
                    },
                    {
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ScanSummaryResponseDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List scan runs",
        "tags": [
          "Scans"
        ]
      }
    },
    "/v1/scans/{id}": {
      "get": {
        "description": "Returns a specific scan with full violation details.",
        "operationId": "getScanById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Scan ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageUrls",
            "required": false,
            "in": "query",
            "description": "Filter returned violations to those with at least one issue on any of the given page URLs. Repeat the parameter for multiple values: ?pageUrls=https://a.com&pageUrls=https://b.com",
            "explode": true,
            "schema": {
              "example": [
                "https://example.com/about"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get scan by ID",
        "tags": [
          "Scans"
        ]
      },
      "delete": {
        "description": "Permanently deletes a scan run and all of its stored issues.",
        "operationId": "deleteScan",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Scan ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Scan deleted"
